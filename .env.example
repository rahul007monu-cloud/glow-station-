# Copy to `.env` and fill in. Har value optional hai — jo blank chhodoge,
# wo feature simply off rahega.

# Meta (Facebook/Instagram) Pixel ID — paid ads chalane se pehle zaroori hai.
# Events Manager > Data Sources > Pixel > Settings me milta hai.
VITE_META_PIXEL_ID=

# Google Analytics 4 measurement ID (optional), e.g. G-XXXXXXXXXX
VITE_GA_ID=

# Owner dashboard (/admin) ka PIN. Default 1234 — isse zaroor badlein.
VITE_ADMIN_PIN=1234
